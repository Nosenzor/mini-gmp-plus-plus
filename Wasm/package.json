{
  "name": "mini-gmp-plus-plus-wasm",
  "version": "1.1.1",
  "description": "mini-gmp-plus-plus (arbitrary-precision integers MiniMPZ and mantissa*2^exponent floats MiniMPF) compiled to WebAssembly via Emscripten",
  "type": "module",
  "main": "./mini-gmp-plus-plus.js",
  "types": "./mini-gmp-plus-plus.d.ts",
  "exports": {
    ".": {
      "types": "./mini-gmp-plus-plus.d.ts",
      "default": "./mini-gmp-plus-plus.js"
    },
    "./mini-gmp-plus-plus.wasm": "./mini-gmp-plus-plus.wasm"
  },
  "files": [
    "mini-gmp-plus-plus.js",
    "mini-gmp-plus-plus.wasm",
    "mini-gmp-plus-plus.d.ts"
  ],
  "sideEffects": false,
  "engines": {
    "node": ">=18"
  },
  "license": "LGPL-3.0-or-later",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Nosenzor/mini-gmp-plus-plus.git",
    "directory": "Wasm"
  },
  "keywords": [
    "wasm",
    "webassembly",
    "emscripten",
    "embind",
    "bigint",
    "arbitrary-precision",
    "gmp",
    "mini-gmp"
  ]
}
